{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main", "price-bubble"],
  "remote": {
    "urls": ["http://127.0.0.1:1420/*", "http://localhost:1420/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-github-token-commands",
    "notification:default",
    "core:window:allow-start-dragging"
  ]
}
