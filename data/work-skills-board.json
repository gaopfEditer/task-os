  "roles": [
    {
      "id": "collector",
      "name": "工作问题收集器",
      "desc": "信息入口：收集→去重→分类→分派，不做深度分析",
      "goal": "不遗漏问题与机会，降低分派成本",
      "deliverables": "待处理问题列表、分派结果、灵感库索引"
    },
    {
      "id": "researcher",
      "name": "技术研究员",
      "desc": "发现可利用的技术、开源项目与工具机会",
      "goal": "技术机会、可用方案、可运行 Demo",
      "deliverables": "技术发现卡片、选型对比、技术资源库"
    },
    {
      "id": "analyst",
      "name": "项目分析师",
      "desc": "需求→架构→任务：把模糊想法变成可执行方案",
      "goal": "需求说明、架构设计、开发任务与验收标准",
      "deliverables": "不为了架构而架构；不确定须标注"
    },
    {
      "id": "engineer",
      "name": "工程实践顾问",
      "desc": "编码、修复、测试、交付可运行成果",
      "goal": "已修改≠已完成：须区分编译/运行/测试/验收",
      "deliverables": "可运行代码、测试与部署说明"
    },
    {
      "id": "coach",
      "name": "技术学习与成长教练",
      "desc": "从真实工作提炼原理与可迁移能力",
      "goal": "原理解释、知识地图、经验总结",
      "deliverables": "不把所有工作变成课程"
    },
    {
      "id": "reviewer",
      "name": "技术评审与批判者",
      "desc": "独立审查方案、代码与成果，纠偏",
      "goal": "评审意见、风险清单、验收结果",
      "deliverables": "按需介入，不刻意找茬"
    }
  ],
